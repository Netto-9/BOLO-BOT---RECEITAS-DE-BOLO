/* =========================================
   UTILIDADES
========================================= */

function normalize(text){
    return String(text || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"")
        .toLowerCase();
}

function escapeHTML(text){
    return String(text ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}

function emoji(flavor){

    const f=normalize(flavor);

    if(f.includes("chocolate")) return "🍫";
    if(f.includes("banana")) return "🍌";
    if(f.includes("abacaxi")) return "🍍";
    if(f.includes("coco")) return "🥥";
    if(f.includes("uva")) return "🍇";
    if(f.includes("laranja")) return "🍊";
    if(f.includes("tangerina")) return "🍊";
    if(f.includes("limao")) return "🍋";
    if(f.includes("yuzu")) return "🍋";
    if(f.includes("maca")) return "🍎";
    if(f.includes("milho")) return "🌽";
    if(f.includes("fuba")) return "🌽";
    if(f.includes("cafe")) return "☕";
    if(f.includes("mel")) return "🍯";
    if(f.includes("nozes")) return "🌰";

    return "🍰";
}


/* =========================================
   RECEITAS PERSONALIZADAS
========================================= */

let custom=[];

try{

    const saved=JSON.parse(
        localStorage.getItem("bolobot_custom")
    );

    if(Array.isArray(saved)){
        custom=saved;
    }

}catch(error){
    custom=[];
}


let all=[...recipes,...custom];


/* =========================================
   ELEMENTOS
========================================= */

const grid=document.getElementById("grid");
const search=document.getElementById("search");
const modal=document.getElementById("modal");
const modalBody=document.getElementById("modalBody");
const loading=document.getElementById("loading");
const toast=document.getElementById("toast");
const count=document.getElementById("count");


/* =========================================
   TOAST
========================================= */

function showToast(message){

    toast.textContent=message;
    toast.classList.add("show");

    clearTimeout(window.toastTimer);

    window.toastTimer=setTimeout(()=>{
        toast.classList.remove("show");
    },2800);
}


/* =========================================
   RENDER
========================================= */

function render(){

    const q=normalize(search.value);

    const filtered=all.filter(recipe=>{

        const text=normalize(
            recipe.name+" "+
            recipe.category+" "+
            recipe.flavor+" "+
            recipe.description
        );

        return !q || text.includes(q);
    });

    count.textContent=all.length;

    if(!filtered.length){

        grid.innerHTML=`
            <div style="
                grid-column:1/-1;
                text-align:center;
                padding:50px;
                background:var(--card);
                border:1px dashed var(--border);
                border-radius:20px;
            ">
                <div style="font-size:3rem">🔎</div>
                <strong>Nenhum bolo encontrado.</strong>
                <p style="color:var(--muted)">
                    Tente outra pesquisa.
                </p>
            </div>
        `;

        return;
    }

    grid.innerHTML=filtered.map((r,index)=>`

        <article class="card">

            <div class="card-img">
                ${emoji(r.flavor)}
            </div>

            <div class="card-body">

                <span class="tag">
                    ${escapeHTML(r.category)}
                </span>

                <h3>
                    ${escapeHTML(r.name)}
                </h3>

                <p>
                    ${escapeHTML(r.description)}
                </p>

                <div class="meta">

                    <span>⏱ ${escapeHTML(r.time)}</span>

                    <span>⭐ ${escapeHTML(r.difficulty)}</span>

                    <span>🍽 10 porções</span>

                </div>

                <div class="card-buttons">

                    <button
                        class="btn primary"
                        onclick="openRecipe(${index}, '${escapeHTML(r.name)}')"
                    >
                        Ver receita
                    </button>

                    ${
                        r.custom
                        ? `
                        <button
                            class="btn delete"
                            onclick="deleteCustom('${r.id}')"
                        >
                            Excluir
                        </button>
                        `
                        :""
                    }

                </div>

            </div>

        </article>

    `).join("");

    window.filteredRecipes=filtered;
}


search.addEventListener("input",render);


/* =========================================
   ABRIR RECEITA
========================================= */

function openRecipe(index,name){

    const recipe=
        window.filteredRecipes.find(
            r=>r.name===name
        );

    if(!recipe){
        showToast("Receita não encontrada.");
        return;
    }

    modalBody.innerHTML=`

        <div class="modal-emoji">
            ${emoji(recipe.flavor)}
        </div>

        <h2>
            ${escapeHTML(recipe.name)}
        </h2>

        <p style="color:var(--muted);margin-top:7px">
            ${escapeHTML(recipe.description)}
        </p>

        <div class="meta">
            <span>⏱ ${escapeHTML(recipe.time)}</span>
            <span>⭐ ${escapeHTML(recipe.difficulty)}</span>
            <span>🍽 10 porções</span>
        </div>

        <h4>🥣 Ingredientes</h4>

        <ul>
            ${recipe.ingredients.map(i=>`
                <li>${escapeHTML(i)}</li>
            `).join("")}
        </ul>

        <h4>👨‍🍳 Modo de preparo</h4>

        <ol>
            ${recipe.steps.map(s=>`
                <li>${escapeHTML(s)}</li>
            `).join("")}
        </ol>

    `;

    modal.classList.add("active");
}


/* =========================================
   FECHAR
========================================= */

document.getElementById("close").onclick=()=>{
    modal.classList.remove("active");
};

modal.onclick=e=>{
    if(e.target===modal){
        modal.classList.remove("active");
    }
};

document.onkeydown=e=>{
    if(e.key==="Escape"){
        modal.classList.remove("active");
    }
};


