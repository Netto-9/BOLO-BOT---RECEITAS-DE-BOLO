========================================= */

function createRecipe(flavor){

    const name=
        flavor.charAt(0).toUpperCase()+
        flavor.slice(1);

    return{

        id:"custom-"+Date.now(),

        name:"Bolo de "+name,

        category:"Criado pelo BoloBot",

        flavor:flavor,

        time:"50 minutos",

        difficulty:"Fácil",

        description:
            "Receita personalizada de bolo de "+
            flavor+
            " criada pelo BoloBot.",

        ingredients:[
            "2 xícaras de farinha de trigo",
            "1 xícara de açúcar",
            "3 ovos",
            "1/2 xícara de óleo",
            "1 xícara de leite",
            "1 xícara de "+flavor,
            "1 colher de sopa de fermento"
        ],

        steps:[
            "Preaqueça o forno a 180 °C.",
            "Misture os ovos, açúcar e óleo.",
            "Adicione o leite e o sabor de "+flavor+".",
            "Acrescente a farinha aos poucos.",
            "Misture o fermento delicadamente.",
            "Coloque a massa em uma forma untada.",
            "Asse por aproximadamente 40 minutos.",
            "Faça o teste do palito.",
            "Deixe esfriar antes de servir."
