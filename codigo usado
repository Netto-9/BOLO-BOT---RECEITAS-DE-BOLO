        custom:true

    };
}


document
.getElementById("aiForm")
.addEventListener("submit",e=>{

    e.preventDefault();

    const input=document.getElementById("flavor");
    const flavor=input.value.trim();

    if(!flavor){
        showToast("Digite um sabor.");
        return;
    }

    loading.classList.add("active");

    setTimeout(()=>{

        try{

            const recipe=createRecipe(flavor);

            custom.unshift(recipe);

            localStorage.setItem(
                "bolobot_custom",
                JSON.stringify(custom)
            );

            all=[...recipes,...custom];

            render();

            input.value="";

            loading.classList.remove("active");

            showToast("✨ Receita criada com sucesso!");

            setTimeout(()=>{
                openRecipe(0,recipe.name);
            },200);

        }catch(error){

            loading.classList.remove("active");

            showToast(
                "Não foi possível criar a receita."
            );
        }

    },700);

});


/* =========================================
   ADICIONAR RECEITA
========================================= */

document
.getElementById("addForm")
.addEventListener("submit",e=>{

    e.preventDefault();

    try{

        const recipe={

            id:"custom-"+Date.now(),

            name:document
                .getElementById("name")
                .value.trim(),

            category:
                document
                .getElementById("category")
                .value.trim() ||
                "Personalizada",

            flavor:
                document
                .getElementById("name")
                .value.trim(),

            description:
                document
                .getElementById("description")
                .value.trim(),

            ingredients:
                document
                .getElementById("ingredients")
                .value
                .split("\n")
                .map(x=>x.trim())
                .filter(Boolean),

            steps:
                document
                .getElementById("steps")
                .value
                .split("\n")
                .map(x=>x.trim())
                .filter(Boolean),

            time:
                document
                .getElementById("time")
                .value.trim() ||
                "45 minutos",

            difficulty:
                document
                .getElementById("difficulty")
                .value,

            custom:true

        };

        if(
            !recipe.name ||
            !recipe.description ||
            !recipe.ingredients.length ||
            !recipe.steps.length
        ){

            showToast(
                "Preencha todos os campos obrigatórios."
            );

            return;
        }

        custom.unshift(recipe);

        localStorage.setItem(
            "bolobot_custom",
            JSON.stringify(custom)
        );

        all=[...recipes,...custom];

        render();

        e.target.reset();

        showToast(
            "🍰 Receita adicionada!"
        );

        document
        .getElementById("catalogo")
        .scrollIntoView({
            behavior:"smooth"
        });

    }catch(error){

        showToast(
            "Não foi possível salvar a receita."
        );

    }

});


/* =========================================
   EXCLUIR
========================================= */

function deleteCustom(id){

    if(!confirm(
        "Deseja excluir esta receita?"
    )){
        return;
    }

    custom=custom.filter(
        r=>r.id!==id
    );

    localStorage.setItem(
        "bolobot_custom",
        JSON.stringify(custom)
    );

    all=[...recipes,...custom];

    render();

    showToast("🗑️ Receita excluída.");
}


/* =========================================
   TEMA
========================================= */

const theme=document.getElementById("theme");

try{

    if(
        localStorage.getItem(
            "bolobot_theme"
        )==="dark"
    ){

        document.body.classList.add("dark");

    }

}catch(error){}


function updateThemeIcon(){

    theme.textContent=
        document.body.classList.contains("dark")
        ?"☀️"
        :"🌙";
}

theme.onclick=()=>{

    document.body.classList.toggle("dark");

    try{

        localStorage.setItem(
            "bolobot_theme",
            document.body.classList.contains("dark")
            ?"dark"
            :"light"
        );

    }catch(error){}

    updateThemeIcon();
};

updateThemeIcon();


/* =========================================
   INICIAR
========================================= */

render();

</script>

