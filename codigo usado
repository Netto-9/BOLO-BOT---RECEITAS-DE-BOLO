<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ff6b35">
<title>BoloBot 🍰</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
    --bg:#fff8f3;
    --card:#fff;
    --text:#211713;
    --muted:#796b65;
    --primary:#ff6b35;
    --primary2:#ff914d;
    --border:#eadbd2;
    --soft:#fff0e7;
    --shadow:0 12px 35px rgba(73,35,20,.10);
}

body.dark{
    --bg:#17110f;
    --card:#241b18;
    --text:#fff7f2;
    --muted:#c8b8b0;
    --border:#493831;
    --soft:#33241f;
    --shadow:0 12px 35px rgba(0,0,0,.3);
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.6;
    transition:.25s;
}

button,input,textarea,select{
    font:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}

/* HEADER */

header{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(255,248,243,.93);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
}

body.dark header{
    background:rgba(23,17,15,.93);
}

.nav{
    width:min(1180px,calc(100% - 30px));
    margin:auto;
    min-height:70px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-size:1.4rem;
    font-weight:900;
}

.logo span{
    color:var(--primary);
}

.menu{
    display:flex;
    gap:6px;
}

.menu a{
    padding:9px 12px;
    border-radius:10px;
    color:var(--muted);
    font-weight:bold;
}

.menu a:hover{
    background:var(--soft);
    color:var(--primary);
}

.theme{
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    width:42px;
    height:42px;
    border-radius:12px;
}

/* HERO */

.hero{
    padding:80px 0;
    background:
    radial-gradient(circle at 10% 20%,#ffd6bf 0,transparent 30%),
    radial-gradient(circle at 90% 20%,#ffe6ae 0,transparent 30%);
}

.container{
    width:min(1180px,calc(100% - 30px));
    margin:auto;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    align-items:center;
    gap:55px;
}

.badge{
    display:inline-block;
    padding:7px 13px;
    border-radius:50px;
    background:var(--soft);
    color:var(--primary);
    font-size:.82rem;
    font-weight:900;
}

.hero h1{
    margin:20px 0;
    font-size:clamp(2.8rem,7vw,5.5rem);
    line-height:.96;
    letter-spacing:-5px;
}

.hero h1 span{
    color:var(--primary);
}

.hero p{
    color:var(--muted);
    max-width:650px;
    font-size:1.08rem;
}

.buttons{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:28px;
}

.btn{
    border:0;
    padding:13px 19px;
    border-radius:13px;
    font-weight:900;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
}

.primary{
    background:var(--primary);
    color:white;
}

.secondary{
    background:var(--card);
    color:var(--text);
    border:1px solid var(--border);
}

.hero-card{
    min-height:380px;
    display:grid;
    place-items:center;
    border:1px solid var(--border);
    border-radius:35px;
    background:linear-gradient(145deg,#fff,#ffe0d1);
    box-shadow:var(--shadow);
}

.big-cake{
    font-size:10rem;
    animation:float 4s ease-in-out infinite;
}

@keyframes float{
    50%{transform:translateY(-15px)}
}

/* STATS */

.stats{
    display:flex;
    gap:35px;
    margin-top:35px;
    flex-wrap:wrap;
}

.stat strong{
    display:block;
    font-size:1.5rem;
}

.stat span{
    color:var(--muted);
    font-size:.85rem;
}

/* SECTION */

section{
    padding:70px 0;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin-bottom:25px;
}

.section-head h2{
    font-size:2rem;
}

.section-head p{
    color:var(--muted);
}

.search{
    width:min(380px,100%);
    padding:14px;
    border-radius:13px;
    border:1px solid var(--border);
    outline:none;
    background:var(--card);
    color:var(--text);
}

.search:focus{
    border-color:var(--primary);
}

/* RECIPES */

.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    overflow:hidden;
    display:flex;
    flex-direction:column;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:22px;
    box-shadow:var(--shadow);
    transition:.2s;
}

.card:hover{
    transform:translateY(-5px);
}

.card-img{
    height:155px;
    display:grid;
    place-items:center;
    font-size:5.2rem;
    background:linear-gradient(135deg,#ffe0d0,#fff0c7);
}

.card-body{
    padding:18px;
    display:flex;
    flex-direction:column;
    flex:1;
}

.tag{
    align-self:flex-start;
    padding:5px 9px;
    border-radius:30px;
    background:var(--soft);
    color:var(--primary);
    font-size:.72rem;
    font-weight:bold;
}

.card h3{
    margin-top:9px;
    font-size:1.2rem;
}

.card p{
    color:var(--muted);
    font-size:.9rem;
    margin-top:6px;
}

.meta{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:auto;
    padding-top:15px;
}

.meta span{
    background:var(--soft);
    padding:5px 8px;
    border-radius:20px;
    font-size:.72rem;
    color:var(--muted);
    font-weight:bold;
}

.card-buttons{
    display:flex;
    gap:8px;
    margin-top:12px;
}

.card-buttons button{
    flex:1;
}

.delete{
    background:transparent;
    color:var(--primary);
    border:1px solid var(--border);
}

/* AI */

.ai-box{
    padding:38px;
    border-radius:30px;
    color:white;
    background:linear-gradient(135deg,#251915,#553026);
    box-shadow:var(--shadow);
}

.ai-box h2{
    margin-top:15px;
    font-size:2rem;
}

.ai-box p{
    color:#e6d5ce;
    margin-top:7px;
}

.ai-form{
    display:grid;
    grid-template-columns:1fr auto;
    gap:10px;
    margin-top:22px;
}

.input{
    width:100%;
    padding:13px;
    border:1px solid var(--border);
    border-radius:13px;
    outline:none;
    background:var(--card);
    color:var(--text);
}

textarea{
    resize:vertical;
    min-height:120px;
}

/* FEATURES */

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.feature{
    padding:25px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:20px;
    box-shadow:var(--shadow);
}

.feature-icon{
    font-size:2rem;
}

.feature h3{
    margin-top:10px;
}

.feature p{
    color:var(--muted);
    margin-top:5px;
}

/* FORM */

.form{
    max-width:850px;
    margin:auto;
    padding:28px;
    border:1px solid var(--border);
    border-radius:24px;
    background:var(--card);
    box-shadow:var(--shadow);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.field{
    display:flex;
    flex-direction:column;
    gap:6px;
}

.full{
    grid-column:1/-1;
}

.field label{
    font-weight:bold;
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    z-index:100;
    display:none;
    align-items:center;
    justify-content:center;
    padding:18px;
    background:rgba(0,0,0,.65);
}

.modal.active{
    display:flex;
}

.modal-content{
    position:relative;
    width:min(720px,100%);
    max-height:90vh;
    overflow:auto;
    padding:28px;
    border-radius:25px;
    background:var(--card);
    color:var(--text);
}

.close{
    position:absolute;
    top:12px;
    right:12px;
    width:40px;
    height:40px;
    border:0;
    border-radius:50%;
    background:var(--soft);
    color:var(--text);
    font-size:1.4rem;
}

.modal-emoji{
    text-align:center;
    padding:25px;
    background:var(--soft);
    border-radius:20px;
    font-size:5rem;
    margin-bottom:20px;
}

.modal-content h2{
    margin-right:50px;
}

.modal-content h4{
    margin-top:22px;
    margin-bottom:8px;
}

.modal-content ul,
.modal-content ol{
    padding-left:24px;
}

/* LOADING */

.loading{
    position:fixed;
    inset:0;
    z-index:200;
    display:none;
    place-items:center;
    background:rgba(255,255,255,.75);
    backdrop-filter:blur(6px);
}

.loading.active{
    display:grid;
}

.loading-box{
    padding:25px;
    border-radius:20px;
    background:var(--card);
    color:var(--text);
    text-align:center;
    box-shadow:var(--shadow);
}

.spinner{
    width:42px;
    height:42px;
    margin:auto auto 12px;
    border:4px solid var(--border);
    border-top-color:var(--primary);
    border-radius:50%;
    animation:spin .8s linear infinite;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

/* TOAST */

.toast{
    position:fixed;
    right:18px;
    bottom:18px;
    z-index:300;
    max-width:350px;
    display:none;
    padding:14px 18px;
    border-radius:14px;
    background:#211713;
    color:white;
}

.toast.show{
    display:block;
}

/* FOOTER */

footer{
    border-top:1px solid var(--border);
    padding:35px 0;
    color:var(--muted);
}

.footer{
    display:flex;
    justify-content:space-between;
    gap:15px;
    flex-wrap:wrap;
}

/* RESPONSIVO */

@media(max-width:950px){

    .hero-grid{
        grid-template-columns:1fr;
    }

    .grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:700px){

    .container,
    .nav{
        width:calc(100% - 22px);
    }

    .menu{
        display:none;
    }

    .hero{
        padding:50px 0;
    }

    .hero h1{
        font-size:clamp(2.7rem,14vw,4rem);
        letter-spacing:-3px;
    }

    .hero-card{
        min-height:230px;
    }

    .big-cake{
        font-size:6.5rem;
    }

    section{
        padding:50px 0;
    }

    .section-head{
        display:block;
    }

    .section-head .search{
        width:100%;
        margin-top:15px;
    }

    .grid,
    .features{
        grid-template-columns:1fr;
    }

    .ai-form{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .modal{
        align-items:flex-end;
        padding:0;
    }

    .modal-content{
        max-height:92vh;
        border-radius:25px 25px 0 0;
    }
}
</style>
</head>

<body>

<header>
    <div class="nav">

        <a href="#inicio" class="logo">
            🍰 <span>BoloBot</span>
        </a>

        <nav class="menu">
            <a href="#catalogo">Receitas</a>
            <a href="#gerar">BoloBot IA</a>
            <a href="#sobre">Sobre</a>
            <a href="#adicionar">Adicionar</a>
        </nav>

        <button class="theme" id="theme">
            🌙
        </button>

    </div>
</header>


<main>

<!-- HERO -->

<section class="hero" id="inicio">

    <div class="container hero-grid">

        <div>

            <span class="badge">
                🤖 ASSISTENTE DE RECEITAS
            </span>

            <h1>
                Seu bolo perfeito começa no
                <span>BoloBot.</span>
            </h1>

            <p>
                Descubra receitas deliciosas, encontre seu bolo
                favorito e crie novas combinações de sabores.
            </p>

            <div class="buttons">

                <a
                    href="#catalogo"
                    class="btn primary"
                >
                    🍰 Ver receitas
                </a>

                <a
                    href="#gerar"
                    class="btn secondary"
                >
                    ✨ Criar receita
                </a>

            </div>

            <div class="stats">

                <div class="stat">
                    <strong id="count">33</strong>
                    <span>receitas</span>
                </div>

                <div class="stat">
                    <strong>📱</strong>
                    <span>mobile</span>
                </div>

                <div class="stat">
                    <strong>💾</strong>
                    <span>salvamento</span>
                </div>

            </div>

        </div>

        <div class="hero-card">
            <div class="big-cake">🍰</div>
        </div>

    </div>

</section>


<!-- CATÁLOGO -->

<section id="catalogo">

    <div class="container">

        <div class="section-head">

            <div>
                <h2>🍰 Catálogo de bolos</h2>
                <p>
                    Pesquise pelo nome ou sabor.
                </p>
            </div>

            <input
                id="search"
                class="search"
                type="search"
                placeholder="🔎 Buscar bolo..."
            >

        </div>

        <div
            id="grid"
            class="grid"
        ></div>

    </div>

</section>


<!-- GERADOR -->

<section id="gerar">

    <div class="container">

        <div class="ai-box">

            <span class="badge">
                ✨ BOLOBOT
            </span>

            <h2>
                Crie uma receita
            </h2>

            <p>
                Digite um sabor e o BoloBot vai criar uma receita
                personalizada para você.
            </p>

            <form
                id="aiForm"
                class="ai-form"
            >

                <input
                    id="flavor"
                    class="input"
                    required
                    maxlength="80"
                    placeholder="Ex.: chocolate com morango"
                >

                <button
                    class="btn primary"
                    type="submit"
                >
                    🤖 Gerar receita
                </button>

            </form>

        </div>

    </div>

</section>


<!-- SOBRE -->

<section id="sobre">

    <div class="container">

        <div class="section-head">

            <div>
                <h2>Por que BoloBot?</h2>
                <p>
                    Uma experiência simples para quem ama fazer bolos.
                </p>
            </div>

        </div>

        <div class="features">

            <div class="feature">
                <div class="feature-icon">🔎</div>
                <h3>Busca rápida</h3>
                <p>
                    Encontre rapidamente o bolo que você deseja preparar.
                </p>
            </div>

            <div class="feature">
                <div class="feature-icon">📱</div>
                <h3>Feito para celular</h3>
                <p>
                    Interface adaptada para smartphones, tablets e computadores.
                </p>
            </div>

            <div class="feature">
                <div class="feature-icon">💾</div>
                <h3>Suas receitas</h3>
                <p>
                    Receitas criadas por você ficam salvas no navegador.
                </p>
            </div>

        </div>

    </div>

</section>


<!-- ADICIONAR -->

<section id="adicionar">

    <div class="container">

        <div class="form">

            <div class="section-head">

                <div>
                    <h2>➕ Adicionar receita</h2>
                    <p>
                        Cadastre sua própria receita.
                    </p>
                </div>

            </div>

            <form id="addForm">

                <div class="form-grid">

                    <div class="field">

                        <label>Nome do bolo</label>

                        <input
                            id="name"
                            class="input"
                            required
                            placeholder="Bolo de Morango"
                        >

                    </div>

                    <div class="field">

                        <label>Categoria</label>

                        <input
                            id="category"
                            class="input"
                            placeholder="Frutas"
                        >

                    </div>

                    <div class="field full">

                        <label>Descrição</label>

                        <textarea
                            id="description"
                            class="input"
                            required
                            placeholder="Uma deliciosa receita..."
                        ></textarea>

                    </div>

                    <div class="field full">

                        <label>Ingredientes</label>

                        <textarea
                            id="ingredients"
                            class="input"
                            required
                            placeholder="2 xícaras de farinha&#10;1 xícara de açúcar&#10;3 ovos"
                        ></textarea>

                    </div>

                    <div class="field full">

                        <label>Modo de preparo</label>

                        <textarea
                            id="steps"
                            class="input"
                            required
                            placeholder="Misture os ingredientes...&#10;Leve ao forno..."
                        ></textarea>

                    </div>

                    <div class="field">

                        <label>Tempo</label>

                        <input
                            id="time"
                            class="input"
                            placeholder="45 minutos"
                        >

                    </div>

                    <div class="field">

                        <label>Dificuldade</label>

                        <select
                            id="difficulty"
                            class="input"
                        >
                            <option>Fácil</option>
                            <option>Média</option>
                            <option>Difícil</option>
                        </select>

                    </div>

                    <div class="field full">

                        <button
                            class="btn primary"
                            type="submit"
                        >
                            💾 Salvar receita
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</section>

</main>


<footer>

    <div class="container footer">

        <span>
            🍰 <strong>BoloBot</strong> — receitas para deixar o dia mais doce.
        </span>

        <span>
            HTML + CSS + JavaScript
        </span>

    </div>

</footer>


<!-- MODAL -->

<div
    id="modal"
    class="modal"
>

    <div class="modal-content">

        <button
            id="close"
            class="close"
        >
            ×
        </button>

        <div id="modalBody"></div>

    </div>

</div>


<!-- LOADING -->

<div
    id="loading"
    class="loading"
>

    <div class="loading-box">

        <div class="spinner"></div>

        <strong>
            O BoloBot está preparando sua receita...
        </strong>

    </div>

</div>


<div
    id="toast"
    class="toast"
></div>


